# Optional model explanation settings. All values are intentionally empty.
# The app reads process environment variables; it does not automatically load
# this file or a copied .env file. Set variables in the terminal before launch.
# Local simulation, rules, SQL and templates do not require a model account.
# BASE_URL is a compatible HTTPS API root; the app appends /chat/completions.
# Never commit real credentials, private prompts or customer data.
ADLAB_LLM_BASE_URL=
ADLAB_LLM_API_KEY=
ADLAB_LLM_MODEL=
